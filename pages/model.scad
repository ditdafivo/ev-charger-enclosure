    render_conduit_assembly("electrical_conduit", conduit_electrical_conduit);
}
if (conduit_low_voltage_conduit) {
    render_conduit_assembly("low_voltage_conduit", conduit_low_voltage_conduit);
}
if (cable_ev_charger_cable) {
    render_cable_assembly("ev_charger_cable", cable_ev_charger_cable);
}
if (cable_low_voltage_cabling) {
    render_cable_assembly("low_voltage_cabling", cable_low_voltage_cabling);
}
if (tambour_tambour_door) {
    render_tambour_assembly(
        "tambour_door",
        tambour_tambour_door,
        tambour_door_open
    );
}

if (siding) {
    for (s = siding_parts) {
        if (object_is_visible(s_name(s))) {
            render_siding_part(s, object_is_highlighted(s_name(s)));
        }
    }
}

if (ground) {
    for (g = grounds) {
        render_ground(g);
    }
}

if ($preview && xygrid_zloc >= 0 && len(xygrid_bounds) == 4) {
    render_xygrid(xygrid_bounds, xygrid_origin, xygrid_zloc);
}