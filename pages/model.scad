function l_dims(type) =
    type == "1x4" ? [0.75, 3.5] :
    type == "1x6" ? [0.75, 5.5] :
    type == "2x4" ? [1.5, 3.5] :
    type == "4x4" ? [3.5, 3.5] :
    [1, 1];

function l_size(l) =
    l_is_angled(l) ?
        len(l_footprint(l)) > 0 ?
            [
                max([for (p = l_footprint(l)) p[0]]) - min([for (p = l_footprint(l)) p[0]]),
                max([for (p = l_footprint(l)) p[1]]) - min([for (p = l_footprint(l)) p[1]]),
                l_thickness(l)
            ] :
            [
                abs(l_end(l)[0] - l_start(l)[0]) + l_width(l),
                abs(l_end(l)[1] - l_start(l)[1]) + l_width(l),
                l_thickness(l)
            ] :
    l_axis(l) == "x" ?
        [
            l_len(l),
            l_rotated(l) ? l_wide(l) : l_dims(l_type(l))[0],
            l_rotated(l) ? l_dims(l_type(l))[0] : l_wide(l)
        ] :
    l_axis(l) == "y" ?
        [
            l_rotated(l) ? l_wide(l) : l_dims(l_type(l))[0],
            l_len(l),
            l_rotated(l) ? l_dims(l_type(l))[0] : l_wide(l)
        ] :
    l_axis(l) == "z" ?
        [
            l_rotated(l) ? l_wide(l) : l_dims(l_type(l))[0],
            l_rotated(l) ? l_dims(l_type(l))[0] : l_wide(l),
            l_len(l)
        ] :
    [1, 1, 1];

function v_add(a, b) =
    [a[0] + b[0], a[1] + b[1], a[2] + b[2]];

function v_sub(a, b) =
    [a[0] - b[0], a[1] - b[1], a[2] - b[2]];

function v_dot(a, b) =
    a[0] * b[0] + a[1] * b[1] + a[2] * b[2];

function v_cross(a, b) =
    [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ];

function v_len(a) = sqrt(v_dot(a, a));

function v_scale(a, scale) =
    [a[0] * scale, a[1] * scale, a[2] * scale];

function v_unit(a) = v_scale(a, 1 / v_len(a));

function v_mid(a, b) =
    [
        (a[0] + b[0]) / 2,
        (a[1] + b[1]) / 2,
        (a[2] + b[2]) / 2
    ];

function l_min(l) =
    l_is_angled(l) ?
        len(l_footprint(l)) > 0 ?
            [
                min([for (p = l_footprint(l)) p[0]]),
                min([for (p = l_footprint(l)) p[1]]),
                l_start(l)[2] - l_thickness(l) / 2
            ] :
            [
                min(l_start(l)[0], l_end(l)[0]) - l_width(l) / 2,
                min(l_start(l)[1], l_end(l)[1]) - l_width(l) / 2,
                l_start(l)[2] - l_thickness(l) / 2
            ] :
        l_start(l);
function l_max(l) =
    l_is_angled(l) ?
        len(l_footprint(l)) > 0 ?
            [
                max([for (p = l_footprint(l)) p[0]]),
                max([for (p = l_footprint(l)) p[1]]),
                l_start(l)[2] + l_thickness(l) / 2
            ] :
            [
                max(l_start(l)[0], l_end(l)[0]) + l_width(l) / 2,
                max(l_start(l)[1], l_end(l)[1]) + l_width(l) / 2,
                l_start(l)[2] + l_thickness(l) / 2
            ] :
        v_add(l_start(l), l_size(l));
function l_center(l) =
    l_is_angled(l) ? v_mid(l_start(l), l_end(l)) : v_mid(l_min(l), l_max(l));

function c_name(c) = c[0];
function c_assembly(c) = c[1];
function c_type(c) = c[2];
function c_member(c) = c[3];
function c_face(c) = c[4];
function c_at(c) = c[5];
function c_min(c) = c[6];
function c_size(c) = c[7];
function c_color(c) = c[8];
function c_shape(c) = c[9];
function c_origin(c) = c[10];
function c_along(c) = c[11];
function c_across(c) = c[12];
function c_out(c) = c[13];
function c_mesh_path(c) = c[14];
function c_mesh_matrix(c) = c[15];
function c_box_primitives(c) = c[16];
function c_cylinder_primitives(c) = c[17];
function c_round_cylinder_joints(c) = c[18];
function c_max(c) = v_add(c_min(c), c_size(c));
function c_center(c) = v_mid(c_min(c), c_max(c));

function r_name(r) = r[0];
function r_assembly(r) = r[1];
function r_trade_size(r) = r[2];
function r_od(r) = r[3];
function r_color(r) = r[4];
function r_points(r) = r[5];
function r_bends(r) = r[6];

function cable_name(c) = c[0];
function cable_assembly(c) = c[1];
function cable_diameter(c) = c[2];
function cable_color(c) = c[3];
function cable_points(c) = c[4];
function cable_length(c) = c[5];

function g_name(g) = g[0];
function g_center(g) = g[1];
function g_normal(g) = g[2];
function g_radius(g) = g[3];
function g_color(g) = g[4];
function g_thickness(g) = g[5];

function t_name(t) = t[0];
function t_assembly(t) = t[1];
function t_track_color(t) = t[2];
function t_slat_color(t) = t[3];
function t_track_diameter(t) = t[4];
function t_slat_pitch(t) = t[5];
function t_slat_thickness(t) = t[6];
function t_slat_depth(t) = t[7];
function t_slat_track_offset(t) = t[8];
function t_left_points(t) = t[9];
function t_right_points(t) = t[10];
function t_bends(t) = t[11];
function t_slats(t, is_open) = is_open ? t[12] : t[13];
function t_installed(t) = len(t) > 14 ? t[14] : [];
function t_track_name(t) = len(t) > 15 ? t[15] : t_name(t);
function t_track_assembly(t) = len(t) > 16 ? t[16] : t_assembly(t);

function ti_channel_width(i) = i[0];
function ti_wall(i) = i[1];
function ti_flange_thickness(i) = i[2];
function ti_flange_extension(i) = i[3];
function ti_engagement(i) = i[4];
function ti_seams(i) = i[5];
function ti_joint_gap(i) = i[6];
function ti_loading_length(i) = i[7];
function ti_stop_length(i) = i[8];
function ti_webbing_count(i) = i[9];
function ti_webbing_width(i) = i[10];
function ti_webbing_thickness(i) = i[11];
function ti_pull_indices(i) = i[12];
function ti_handle_width(i) = i[13];
function ti_handle_height(i) = i[14];
function ti_handle_projection(i) = i[15];
function ti_webbing_color(i) = i[16];
function ti_handle_color(i) = i[17];
function ti_inward_hardware_projection(i) = len(i) > 18 ? i[18] : 0;

function ts_left(s) = s[0];
function ts_right(s) = s[1];
function ts_tangent(s) = s[2];

function s_name(s) = s[0];
function s_material(s) = s[1];
function s_start(s) = s[2];
function s_size(s) = s[3];
function s_color(s) = s[4];

function p_min(p) = p[0];
function p_size(p) = p[1];

function cp_origin(p) = p[0];
function cp_axis(p) = p[1];
function cp_length(p) = p[2];
function cp_diameter(p) = p[3];
function cp_direction(p) =
    is_string(cp_axis(p)) ?
        cp_axis(p) == "along" ? [1, 0, 0] :
        cp_axis(p) == "across" ? [0, 1, 0] : [0, 0, 1] :
    v_unit(cp_axis(p));

function xygrid_line_color(coordinate) =
    coordinate % 10 == 0 ? [0.90, 0.16, 0.12, 0.75] :
    coordinate % 5 == 0 ? [0.12, 0.42, 0.90, 0.60] :
    [0.65, 0.68, 0.72, 0.35];

function xygrid_line_width(coordinate) =
    coordinate % 10 == 0 ? 0.06 :
    coordinate % 5 == 0 ? 0.04 :
    0.02;

function c_component_matrix(c) =
    [
        [c_along(c)[0], c_across(c)[0], c_out(c)[0], c_origin(c)[0]],
        [c_along(c)[1], c_across(c)[1], c_out(c)[1], c_origin(c)[1]],
        [c_along(c)[2], c_across(c)[2], c_out(c)[2], c_origin(c)[2]],
        [0, 0, 0, 1]
    ];

module lumber_name(l) {
    c = l_center(l);
    maxp = l_max(l);

    translate([c[0], c[1], maxp[2] + label_lift])
    linear_extrude(height = 0.03)
        text(
            l_name(l),
            size = label_size,
            halign = "center",
            valign = "center"
        );
}

module routed_seat_volume(r) {
    translate([0, 0, rs_top_z(r) - rs_depth(r) - 0.001])
        linear_extrude(height = rs_depth(r) + 0.002)
            polygon(points = rs_points(r));
}

module render_lumber(l, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : lumber_color) difference() {
        if (l_is_angled(l)) {
            if (len(l_footprint(l)) > 0)
                translate([0, 0, l_start(l)[2] - l_thickness(l) / 2])
                    linear_extrude(height = l_thickness(l))
                        polygon(points = l_footprint(l));
            else
                translate(l_start(l))
                    rotate([0, 0, l_angle(l)])
                        translate([0, -l_width(l) / 2, -l_thickness(l) / 2])
                            cube([l_len(l), l_width(l), l_thickness(l)]);
        } else {
            translate(l_start(l))
                cube(l_size(l));
        }
        for (r = routed_seats)
            if (rs_member(r) == l_name(l))
                routed_seat_volume(r);
    }

    if (labels && highlighted)
        lumber_name(l);
}

module component_name(c) {
    center = c_center(c);
    maxp = c_max(c);

    translate([center[0], center[1], maxp[2] + label_lift])
    linear_extrude(height = 0.03)
        text(
            c_name(c),
            size = label_size,
            halign = "center",
            valign = "center"
        );
}

module render_component_cylinder(p) {
    direction = cp_direction(p);
    rotation_axis = v_cross([0, 0, 1], direction);
    rotation_length = v_len(rotation_axis);
    normalized_axis = rotation_length > 1e-9 ?
        v_scale(rotation_axis, 1 / rotation_length) : [1, 0, 0];
    angle = rotation_length > 1e-9 ? acos(direction[2]) :
        direction[2] < 0 ? 180 : 0;

    translate(cp_origin(p))
        rotate(a = angle, v = normalized_axis)
            cylinder(h = cp_length(p), d = cp_diameter(p), $fn = 36);
}

module render_component_cylinder_joints(c) {
    // Round only internal segment junctions; the bell mouth and outlet stay flat.
    for (i = [0 : len(c_cylinder_primitives(c)) - 2]) {
        p = c_cylinder_primitives(c)[i];
        direction = cp_direction(p);
        translate(v_add(cp_origin(p), v_scale(direction, cp_length(p))))
            sphere(d = cp_diameter(p), $fn = 24);
    }
}

module render_component(c, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : c_color(c)) {
        if (c_shape(c) == "mesh") {
            multmatrix(c_component_matrix(c))
                multmatrix(c_mesh_matrix(c))
                    import(file = c_mesh_path(c), convexity = 10);
        } else if (c_shape(c) == "primitive_union") {
            multmatrix(c_component_matrix(c))
                union() {
                    for (p = c_box_primitives(c)) {
                        translate(p_min(p))
                            cube(p_size(p));
                    }
                    for (p = c_cylinder_primitives(c))
                        render_component_cylinder(p);
                    if (c_round_cylinder_joints(c))
                        render_component_cylinder_joints(c);
                }
        } else {
            translate(c_min(c))
                cube(c_size(c));
        }
    }

    if (labels && highlighted)
        component_name(c);
}

module conduit_segment(a, b, od) {
    delta = v_sub(b, a);
    seg_len = v_len(delta);

    if (seg_len > 0) {
        dir = v_unit(delta);
        axis = abs(dir[2]) > 0.999 ? [1, 0, 0] : [-dir[1], dir[0], 0];
        angle = dir[2] < -0.999 ? 180 : acos(dir[2]);

        translate(a)
            rotate(a = angle, v = axis)
                cylinder(h = seg_len, d = od, $fn = 36);
    }
}

module render_conduit(r, highlighted = false) {
    pts = r_points(r);

    color(highlighted ? build_step_highlight_color() : r_color(r)) {
        for (i = [0 : len(pts) - 2]) {
            conduit_segment(pts[i], pts[i + 1], r_od(r));
        }
    }
}

module render_cable(c, highlighted = false) {
    pts = cable_points(c);
    diameter = cable_diameter(c);

    color(highlighted ? build_step_highlight_color() : cable_color(c)) {
        for (i = [0 : len(pts) - 2]) {
            conduit_segment(pts[i], pts[i + 1], diameter);
        }
        for (point = pts) {
            translate(point)
                sphere(d = diameter, $fn = 36);
        }
    }
}

module render_ground(g) {
    if (len(g) > 6) {
        color(g_color(g))
            intersection() {
                polyhedron(points = g[6], faces = g[7], convexity = 10);
                translate([g_center(g)[0], g_center(g)[1],
                           min([for (p = g[6]) p[2]]) - 1])
                    cylinder(r = g_radius(g),
                             h = max([for (p = g[6]) p[2]])
                                 - min([for (p = g[6]) p[2]]) + 2,
                             $fn = 96);
            }
    } else {
    normal = g_normal(g);
    axis = v_len(v_cross([0, 0, 1], normal)) == 0 ?
        [1, 0, 0] :
        v_cross([0, 0, 1], normal);
    angle = acos(v_dot([0, 0, 1], normal));

    color(g_color(g))
        translate(g_center(g))
            rotate(a = angle, v = axis)
                cylinder(
                    h = g_thickness(g),
                    r = g_radius(g),
                    center = true,
                    $fn = 96
                );
    }
}

module render_footing(f, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : f_color(f))
        translate([f_center(f)[0], f_center(f)[1], f_bottom_z(f)])
            cylinder(
                h = f_top_z(f) - f_bottom_z(f),
                d = f_diameter(f),
                $fn = 96
            );
}

module render_tambour_track(points, diameter) {
    for (i = [0 : len(points) - 2]) {
        conduit_segment(points[i], points[i + 1], diameter);
    }
}

module tambour_oriented_box(center, opening_dir, travel_dir, depth_dir, size) {
    multmatrix([
        [opening_dir[0], travel_dir[0], depth_dir[0], center[0]],
        [opening_dir[1], travel_dir[1], depth_dir[1], center[1]],
        [opening_dir[2], travel_dir[2], depth_dir[2], center[2]],
        [0, 0, 0, 1]
    ]) cube(size, center = true);
}

module render_tambour_channel(points, opening_dir, installed) {
    channel_width = ti_channel_width(installed);
    wall = ti_wall(installed);
    flange_thickness = ti_flange_thickness(installed);
    extension = ti_flange_extension(installed);
    engagement = ti_engagement(installed);
    outer_width = channel_width + 2 * wall;

    for (i = [0 : len(points) - 2]) {
        start = points[i];
        end = points[i + 1];
        travel_dir = v_unit(v_sub(end, start));
        depth_dir = v_unit(v_cross(opening_dir, travel_dir));
        center = v_mid(start, end);
        length = v_len(v_sub(end, start));

        tambour_oriented_box(
            v_add(center, v_scale(opening_dir, flange_thickness / 2)),
            opening_dir,
            travel_dir,
            depth_dir,
            [flange_thickness, length, outer_width + 2 * extension]
        );
        for (depth_sign = [-1, 1])
            tambour_oriented_box(
                v_add(
                    v_add(center, v_scale(opening_dir, engagement / 2)),
                    v_scale(depth_dir, depth_sign * (channel_width + wall) / 2)
                ),
                opening_dir,
                travel_dir,
                depth_dir,
                [engagement, length, wall]
            );
    }
}

module render_tambour_seam(s, opening_dir, installed) {
    left = ts_left(s);
    right = ts_right(s);
    point = opening_dir[0] > 0 ? left : right;
    travel_dir = v_unit(ts_tangent(s));
    depth_dir = v_unit(v_cross(opening_dir, travel_dir));
    outer_width = ti_channel_width(installed) + 2 * ti_wall(installed);

    tambour_oriented_box(
        v_add(point, v_scale(opening_dir, ti_engagement(installed) / 2)),
        opening_dir,
        travel_dir,
        depth_dir,
        [
            ti_engagement(installed),
            max(ti_joint_gap(installed), 0.01),
            outer_width
        ]
    );
}

module render_tambour_service_parts(points, opening_dir, installed) {
    start = points[0];
    travel_dir = v_unit(v_sub(points[1], points[0]));
    depth_dir = v_unit(v_cross(opening_dir, travel_dir));
    outer_width = ti_channel_width(installed) + 2 * ti_wall(installed);
    loading_length = ti_loading_length(installed);
    stop_length = ti_stop_length(installed);

    if (loading_length > 0)
        tambour_oriented_box(
            v_add(
                v_add(start, v_scale(travel_dir, loading_length / 2)),
                v_scale(opening_dir, ti_engagement(installed) + 0.01)
            ),
            opening_dir,
            travel_dir,
            depth_dir,
            [0.02, loading_length, outer_width]
        );
    if (stop_length > 0)
        tambour_oriented_box(
            v_add(
                v_add(start, v_scale(travel_dir, stop_length / 2)),
                v_scale(opening_dir, ti_engagement(installed) / 2)
            ),
            opening_dir,
            travel_dir,
            depth_dir,
            [ti_engagement(installed), stop_length, outer_width]
        );
}

module render_tambour_slat(s, thickness, depth) {
    left = ts_left(s);
    right = ts_right(s);
    span = v_sub(right, left);
    span_dir = v_unit(span);
    travel_dir = v_unit(ts_tangent(s));
    depth_dir = v_unit(v_cross(span_dir, travel_dir));
    center = v_mid(left, right);

    multmatrix([
        [span_dir[0], travel_dir[0], depth_dir[0], center[0]],
        [span_dir[1], travel_dir[1], depth_dir[1], center[1]],
        [span_dir[2], travel_dir[2], depth_dir[2], center[2]],
        [0, 0, 0, 1]
    ])
        cube([v_len(span), thickness, depth], center = true);
}

module render_tambour_slat_details(s, index, thickness, depth, installed) {
    left = ts_left(s);
    right = ts_right(s);
    span = v_sub(right, left);
    span_length = v_len(span);
    span_dir = v_unit(span);
    travel_dir = v_unit(ts_tangent(s));
    depth_dir = v_unit(v_cross(span_dir, travel_dir));
    center = v_mid(left, right);
    webbing_count = ti_webbing_count(installed);

    color(ti_webbing_color(installed))
        for (strip = [1 : webbing_count]) {
            across = -span_length / 2 + strip * span_length / (webbing_count + 1);
            tambour_oriented_box(
                v_add(
                    v_add(center, v_scale(span_dir, across)),
                    v_scale(depth_dir, depth / 2 + ti_webbing_thickness(installed) / 2)
                ),
                span_dir,
                travel_dir,
                depth_dir,
                [ti_webbing_width(installed), thickness, ti_webbing_thickness(installed)]
            );
        }

    if (len(search(index, ti_pull_indices(installed))) > 0)
        color(ti_handle_color(installed))
            tambour_oriented_box(
                v_add(
                    center,
                    v_scale(
                        depth_dir,
                        -(depth / 2 + ti_handle_projection(installed) / 2)
                    )
                ),
                span_dir,
                travel_dir,
                depth_dir,
                [
                    ti_handle_width(installed),
                    ti_handle_height(installed),
                    ti_handle_projection(installed)
                ]
            );
}

module render_tambour_track_component(t, highlighted = false) {
    installed = t_installed(t);
    color(highlighted ? build_step_highlight_color() : t_track_color(t)) {
        if (len(installed) == 0) {
            render_tambour_track(t_left_points(t), t_track_diameter(t));
            render_tambour_track(t_right_points(t), t_track_diameter(t));
        } else {
            render_tambour_channel(t_left_points(t), [1, 0, 0], installed);
            render_tambour_channel(t_right_points(t), [-1, 0, 0], installed);
            render_tambour_service_parts(t_left_points(t), [1, 0, 0], installed);
            render_tambour_service_parts(t_right_points(t), [-1, 0, 0], installed);
        }
    }

    if (len(installed) > 0)
        color(highlighted ? build_step_highlight_color() : [0.15, 0.16, 0.17, 1])
            for (seam = ti_seams(installed)) {
                render_tambour_seam(seam, [1, 0, 0], installed);
                render_tambour_seam(seam, [-1, 0, 0], installed);
            }
}

module render_tambour_door_component(t, is_open, highlighted = false) {
    installed = t_installed(t);
    color(highlighted ? build_step_highlight_color() : t_slat_color(t)) {
        for (s = t_slats(t, is_open))
            render_tambour_slat(s, t_slat_thickness(t), t_slat_depth(t));
    }
    if (len(installed) > 0)
        for (index = [0 : len(t_slats(t, is_open)) - 1])
            render_tambour_slat_details(
                t_slats(t, is_open)[index],
                is_open ? len(t_slats(t, is_open)) - 1 - index : index,
                t_slat_thickness(t),
                t_slat_depth(t),
                installed
            );
}

module render_siding_part(s, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : s_color(s))
        translate(s_start(s))
            cube(s_size(s));
}

module render_xygrid(bounds, origin, zloc) {
    min_x = bounds[0];
    max_x = bounds[1];
    min_y = bounds[2];
    max_y = bounds[3];
    origin_x = origin[0];
    origin_y = origin[1];
    line_height = 0.01;

    for (x = [ceil(min_x - origin_x) : floor(max_x - origin_x)]) {
        line_width = xygrid_line_width(x);
        color(xygrid_line_color(x))
            translate([
                origin_x + x - line_width / 2,
                min_y,
                zloc - line_height / 2
            ])
                cube([line_width, max_y - min_y, line_height]);
    }

    for (y = [ceil(min_y - origin_y) : floor(max_y - origin_y)]) {
        line_width = xygrid_line_width(y);
        color(xygrid_line_color(y))
            translate([
                min_x,
                origin_y + y - line_width / 2,
                zloc - line_height / 2
            ])
                cube([max_x - min_x, line_width, line_height]);
    }
}

module render_xzgrid(bounds, origin, yloc) {
    min_x = bounds[0];
    max_x = bounds[1];
    min_z = bounds[4];
    max_z = bounds[5];
    origin_x = origin[0];
    origin_z = 0;
    line_height = 0.01;

    for (x = [ceil(min_x - origin_x) : floor(max_x - origin_x)]) {
        line_width = xygrid_line_width(x);
        color(xygrid_line_color(x))
            translate([
                origin_x + x - line_width / 2,
                yloc - line_height / 2,
                min_z
            ])
                cube([line_width, line_height, max_z - min_z]);
    }

    for (z = [ceil(min_z - origin_z) : floor(max_z - origin_z)]) {
        line_width = xygrid_line_width(z);
        color(xygrid_line_color(z))
            translate([
                min_x,
                yloc - line_height / 2,
                origin_z + z - line_width / 2
            ])
                cube([max_x - min_x, line_height, line_width]);
    }
}

module render_yzgrid(bounds, origin, xloc) {
    min_y = bounds[2];
    max_y = bounds[3];
    min_z = bounds[4];
    max_z = bounds[5];
    origin_y = origin[1];
    origin_z = 0;
    line_height = 0.01;

    for (y = [ceil(min_y - origin_y) : floor(max_y - origin_y)]) {
        line_width = xygrid_line_width(y);
        color(xygrid_line_color(y))
            translate([
                xloc - line_height / 2,
                origin_y + y - line_width / 2,
                min_z
            ])
                cube([line_height, line_width, max_z - min_z]);
    }

    for (z = [ceil(min_z - origin_z) : floor(max_z - origin_z)]) {
        line_width = xygrid_line_width(z);
        color(xygrid_line_color(z))
            translate([
                xloc - line_height / 2,
                min_y,
                origin_z + z - line_width / 2
            ])
                cube([line_height, max_y - min_y, line_width]);
    }
}

module render_assembly(assembly_name, enabled) {
    if (enabled) {
        for (p = pieces) {
            if (
                l_assembly(p) == assembly_name
                    && lumber_object_is_enabled(l_name(p))
                    && object_is_visible(l_name(p))
            ) {
                render_lumber(p, object_is_highlighted(l_name(p)));
            }
        }
    }
}

