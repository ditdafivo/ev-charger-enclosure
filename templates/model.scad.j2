/*
  Generated OpenSCAD lumber model.
  Units: inches.

  The authoritative BOM is generated by Python.
  This file is for visualization.

  Edit these toggles to control displayed assemblies.
*/

// true: fully open; false: fully closed
tambour_door_open = true;
siding = true;
ground = false;
xygrid_zloc = -1;
{% if build_step_count %}
build_step = {{ build_step_count + 1 }}; // [{{ range(0, build_step_count + 2) | map('string') | join(', ') }}]

{% endif %}

lumber_labels = false;
component_labels = false;
label_size = 1.25;
label_lift = 0.03;
lumber_color = [0.50, 0.18, 0.08, 1.0];
/* [Hidden] */
{% for assembly in assemblies %}
{{ assembly.toggle }} = true;
{% endfor %}
{% for assembly in component_assemblies %}
{{ assembly.toggle }} = true;
{% endfor %}
{% for assembly in conduit_assemblies %}
{{ assembly.toggle }} = true;
{% endfor %}
{% for assembly in cable_assemblies %}
{{ assembly.toggle }} = true;
{% endfor %}
{% for assembly in tambour_assemblies %}
{{ assembly.toggle }} = true;
{% endfor %}


pieces = [
    {{ piece_records | join(',\n    ') }}
];

components = [
    {{ component_records | join(',\n    ') }}
];

conduits = [
    {{ conduit_records | join(',\n    ') }}
];

cables = [
    {{ cable_records | join(',\n    ') }}
];

grounds = [
    {{ ground_records | join(',\n    ') }}
];

tambours = [
    {{ tambour_records | join(',\n    ') }}
];

siding_parts = [
    {{ siding_records | join(',\n    ') }}
];

xygrid_bounds = {{ xygrid_bounds }};

assert(
    xygrid_zloc == floor(xygrid_zloc),
    str("xygrid_zloc must be an integer; got ", xygrid_zloc)
);

{% if build_step_count %}
build_step_count = {{ build_step_count }};
build_step_objects = [
    {{ build_step_records | join(',\n    ') }}
];

assert(
    build_step == floor(build_step)
        && build_step >= 0
        && build_step <= build_step_count + 1,
    str(
        "build_step must be an integer from 0 through ",
        build_step_count + 1,
        "; got ",
        build_step
    )
);

function object_build_step(name) =
    let(matches = [
        for (entry = build_step_objects)
            if (entry[0] == name) entry[1]
    ])
    assert(len(matches) == 1, str("No unique build step for object ", name))
    matches[0];
function object_is_visible(name) =
    object_build_step(name) <= build_step;
function object_is_highlighted(name) =
    build_step > 0 && object_build_step(name) == build_step;
{% else %}
function object_is_visible(name) = true;
function object_is_highlighted(name) = false;
{% endif %}
function build_step_highlight_color() = [1.0, 0.82, 0.0, 1.0];

function l_name(l) = l[0];
function l_assembly(l) = l[1];
function l_type(l) = l[2];
function l_axis(l) = l[3];
function l_start(l) = l[4];
function l_len(l) = l[5];
function l_rotated(l) = l[6];
function l_end(l) = len(l) > 7 ? l[7] : l_start(l);
function l_width(l) = len(l) > 8 ? l[8] : 0;
function l_thickness(l) = len(l) > 9 ? l[9] : 0;
function l_angle(l) = len(l) > 10 ? l[10] : 0;
function l_is_angled(l) = l_axis(l) == "angled";

function l_dims(type) =
    type == "2x4" ? [1.5, 3.5] :
    type == "4x4" ? [3.5, 3.5] :
    [1, 1];

function l_size(l) =
    l_is_angled(l) ?
        [
            abs(l_end(l)[0] - l_start(l)[0]) + l_width(l),
            abs(l_end(l)[1] - l_start(l)[1]) + l_width(l),
            l_thickness(l)
        ] :
    l_axis(l) == "x" ?
        [
            l_len(l),
            l_rotated(l) ? l_dims(l_type(l))[1] : l_dims(l_type(l))[0],
            l_rotated(l) ? l_dims(l_type(l))[0] : l_dims(l_type(l))[1]
        ] :
    l_axis(l) == "y" ?
        [
            l_rotated(l) ? l_dims(l_type(l))[1] : l_dims(l_type(l))[0],
            l_len(l),
            l_rotated(l) ? l_dims(l_type(l))[0] : l_dims(l_type(l))[1]
        ] :
    l_axis(l) == "z" ?
        [
            l_rotated(l) ? l_dims(l_type(l))[1] : l_dims(l_type(l))[0],
            l_rotated(l) ? l_dims(l_type(l))[0] : l_dims(l_type(l))[1],
            l_len(l)
        ] :
    [1, 1, 1];

function v_add(a, b) =
    [a[0] + b[0], a[1] + b[1], a[2] + b[2]];

function v_sub(a, b) =
    [a[0] - b[0], a[1] - b[1], a[2] - b[2]];

function v_dot(a, b) =
    a[0] * b[0] + a[1] * b[1] + a[2] * b[2];

function v_cross(a, b) =
    [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ];

function v_len(a) = sqrt(v_dot(a, a));

function v_scale(a, scale) =
    [a[0] * scale, a[1] * scale, a[2] * scale];

function v_unit(a) = v_scale(a, 1 / v_len(a));

function v_mid(a, b) =
    [
        (a[0] + b[0]) / 2,
        (a[1] + b[1]) / 2,
        (a[2] + b[2]) / 2
    ];

function l_min(l) =
    l_is_angled(l) ?
        [
            min(l_start(l)[0], l_end(l)[0]) - l_width(l) / 2,
            min(l_start(l)[1], l_end(l)[1]) - l_width(l) / 2,
            l_start(l)[2] - l_thickness(l) / 2
        ] :
        l_start(l);
function l_max(l) =
    l_is_angled(l) ?
        [
            max(l_start(l)[0], l_end(l)[0]) + l_width(l) / 2,
            max(l_start(l)[1], l_end(l)[1]) + l_width(l) / 2,
            l_start(l)[2] + l_thickness(l) / 2
        ] :
        v_add(l_start(l), l_size(l));
function l_center(l) =
    l_is_angled(l) ? v_mid(l_start(l), l_end(l)) : v_mid(l_min(l), l_max(l));

function c_name(c) = c[0];
function c_assembly(c) = c[1];
function c_type(c) = c[2];
function c_member(c) = c[3];
function c_face(c) = c[4];
function c_at(c) = c[5];
function c_min(c) = c[6];
function c_size(c) = c[7];
function c_color(c) = c[8];
function c_shape(c) = c[9];
function c_origin(c) = c[10];
function c_along(c) = c[11];
function c_across(c) = c[12];
function c_out(c) = c[13];
function c_mesh_path(c) = c[14];
function c_mesh_matrix(c) = c[15];
function c_box_primitives(c) = c[16];
function c_cylinder_primitives(c) = c[17];
function c_max(c) = v_add(c_min(c), c_size(c));
function c_center(c) = v_mid(c_min(c), c_max(c));

function r_name(r) = r[0];
function r_assembly(r) = r[1];
function r_trade_size(r) = r[2];
function r_od(r) = r[3];
function r_color(r) = r[4];
function r_points(r) = r[5];
function r_bends(r) = r[6];

function cable_name(c) = c[0];
function cable_assembly(c) = c[1];
function cable_diameter(c) = c[2];
function cable_color(c) = c[3];
function cable_points(c) = c[4];
function cable_length(c) = c[5];

function g_name(g) = g[0];
function g_center(g) = g[1];
function g_normal(g) = g[2];
function g_radius(g) = g[3];
function g_color(g) = g[4];
function g_thickness(g) = g[5];

function t_name(t) = t[0];
function t_assembly(t) = t[1];
function t_track_color(t) = t[2];
function t_slat_color(t) = t[3];
function t_track_diameter(t) = t[4];
function t_slat_pitch(t) = t[5];
function t_slat_thickness(t) = t[6];
function t_slat_depth(t) = t[7];
function t_left_points(t) = t[8];
function t_right_points(t) = t[9];
function t_bends(t) = t[10];
function t_slats(t, is_open) = is_open ? t[11] : t[12];

function ts_left(s) = s[0];
function ts_right(s) = s[1];
function ts_tangent(s) = s[2];

function s_name(s) = s[0];
function s_material(s) = s[1];
function s_start(s) = s[2];
function s_size(s) = s[3];
function s_color(s) = s[4];

function p_min(p) = p[0];
function p_size(p) = p[1];

function cp_origin(p) = p[0];
function cp_axis(p) = p[1];
function cp_length(p) = p[2];
function cp_diameter(p) = p[3];

function xygrid_line_color(coordinate) =
    coordinate % 10 == 0 ? [0.90, 0.16, 0.12, 0.75] :
    coordinate % 5 == 0 ? [0.12, 0.42, 0.90, 0.60] :
    [0.65, 0.68, 0.72, 0.35];

function xygrid_line_width(coordinate) =
    coordinate % 10 == 0 ? 0.06 :
    coordinate % 5 == 0 ? 0.04 :
    0.02;

function c_component_matrix(c) =
    [
        [c_along(c)[0], c_across(c)[0], c_out(c)[0], c_origin(c)[0]],
        [c_along(c)[1], c_across(c)[1], c_out(c)[1], c_origin(c)[1]],
        [c_along(c)[2], c_across(c)[2], c_out(c)[2], c_origin(c)[2]],
        [0, 0, 0, 1]
    ];

module lumber_name(l) {
    c = l_center(l);
    maxp = l_max(l);

    translate([c[0], c[1], maxp[2] + label_lift])
    linear_extrude(height = 0.03)
        text(
            l_name(l),
            size = label_size,
            halign = "center",
            valign = "center"
        );
}

module render_lumber(l, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : lumber_color) {
        if (l_is_angled(l)) {
            translate(l_start(l))
                rotate([0, 0, l_angle(l)])
                    translate([0, -l_width(l) / 2, -l_thickness(l) / 2])
                        cube([l_len(l), l_width(l), l_thickness(l)]);
        } else {
            translate(l_start(l))
                cube(l_size(l));
        }
    }

    if (lumber_labels)
        lumber_name(l);
}

module component_name(c) {
    center = c_center(c);
    maxp = c_max(c);

    translate([center[0], center[1], maxp[2] + label_lift])
    linear_extrude(height = 0.03)
        text(
            c_name(c),
            size = label_size,
            halign = "center",
            valign = "center"
        );
}

module render_component_cylinder(p) {
    translate(cp_origin(p)) {
        if (cp_axis(p) == "along")
            rotate([0, 90, 0])
                cylinder(h = cp_length(p), d = cp_diameter(p), $fn = 36);
        else if (cp_axis(p) == "across")
            rotate([-90, 0, 0])
                cylinder(h = cp_length(p), d = cp_diameter(p), $fn = 36);
        else
            cylinder(h = cp_length(p), d = cp_diameter(p), $fn = 36);
    }
}

module render_component(c, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : c_color(c)) {
        if (c_shape(c) == "mesh") {
            multmatrix(c_component_matrix(c))
                multmatrix(c_mesh_matrix(c))
                    import(file = c_mesh_path(c), convexity = 10);
        } else if (c_shape(c) == "primitive_union") {
            multmatrix(c_component_matrix(c))
                union() {
                    for (p = c_box_primitives(c)) {
                        translate(p_min(p))
                            cube(p_size(p));
                    }
                    for (p = c_cylinder_primitives(c))
                        render_component_cylinder(p);
                }
        } else {
            translate(c_min(c))
                cube(c_size(c));
        }
    }

    if (component_labels)
        component_name(c);
}

module conduit_segment(a, b, od) {
    delta = v_sub(b, a);
    seg_len = v_len(delta);

    if (seg_len > 0) {
        dir = v_unit(delta);
        axis = abs(dir[2]) > 0.999 ? [1, 0, 0] : [-dir[1], dir[0], 0];
        angle = dir[2] < -0.999 ? 180 : acos(dir[2]);

        translate(a)
            rotate(a = angle, v = axis)
                cylinder(h = seg_len, d = od, $fn = 36);
    }
}

module render_conduit(r, highlighted = false) {
    pts = r_points(r);

    color(highlighted ? build_step_highlight_color() : r_color(r)) {
        for (i = [0 : len(pts) - 2]) {
            conduit_segment(pts[i], pts[i + 1], r_od(r));
        }
    }
}

module render_cable(c, highlighted = false) {
    pts = cable_points(c);
    diameter = cable_diameter(c);

    color(highlighted ? build_step_highlight_color() : cable_color(c)) {
        for (i = [0 : len(pts) - 2]) {
            conduit_segment(pts[i], pts[i + 1], diameter);
        }
        for (point = pts) {
            translate(point)
                sphere(d = diameter, $fn = 36);
        }
    }
}

module render_ground(g) {
    normal = g_normal(g);
    axis = v_len(v_cross([0, 0, 1], normal)) == 0 ?
        [1, 0, 0] :
        v_cross([0, 0, 1], normal);
    angle = acos(v_dot([0, 0, 1], normal));

    color(g_color(g))
        translate(g_center(g))
            rotate(a = angle, v = axis)
                cylinder(
                    h = g_thickness(g),
                    r = g_radius(g),
                    center = true,
                    $fn = 96
                );
}

module render_tambour_track(points, diameter) {
    for (i = [0 : len(points) - 2]) {
        conduit_segment(points[i], points[i + 1], diameter);
    }
}

module render_tambour_slat(s, thickness, depth) {
    left = ts_left(s);
    right = ts_right(s);
    span = v_sub(right, left);
    span_dir = v_unit(span);
    travel_dir = v_unit(ts_tangent(s));
    depth_dir = v_unit(v_cross(span_dir, travel_dir));
    center = v_mid(left, right);

    multmatrix([
        [span_dir[0], travel_dir[0], depth_dir[0], center[0]],
        [span_dir[1], travel_dir[1], depth_dir[1], center[1]],
        [span_dir[2], travel_dir[2], depth_dir[2], center[2]],
        [0, 0, 0, 1]
    ])
        cube([v_len(span), thickness, depth], center = true);
}

module render_tambour(t, is_open, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : t_track_color(t)) {
        render_tambour_track(t_left_points(t), t_track_diameter(t));
        render_tambour_track(t_right_points(t), t_track_diameter(t));
    }

    color(highlighted ? build_step_highlight_color() : t_slat_color(t)) {
        for (s = t_slats(t, is_open)) {
            render_tambour_slat(s, t_slat_thickness(t), t_slat_depth(t));
        }
    }
}

module render_siding_part(s, highlighted = false) {
    color(highlighted ? build_step_highlight_color() : s_color(s))
        translate(s_start(s))
            cube(s_size(s));
}

module render_xygrid(bounds, zloc) {
    min_x = bounds[0];
    max_x = bounds[1];
    min_y = bounds[2];
    max_y = bounds[3];
    line_height = 0.01;

    for (x = [ceil(min_x) : floor(max_x)]) {
        line_width = xygrid_line_width(x);
        color(xygrid_line_color(x))
            translate([x - line_width / 2, min_y, zloc - line_height / 2])
                cube([line_width, max_y - min_y, line_height]);
    }

    for (y = [ceil(min_y) : floor(max_y)]) {
        line_width = xygrid_line_width(y);
        color(xygrid_line_color(y))
            translate([min_x, y - line_width / 2, zloc - line_height / 2])
                cube([max_x - min_x, line_width, line_height]);
    }
}

module render_assembly(assembly_name, enabled) {
    if (enabled) {
        for (p = pieces) {
            if (l_assembly(p) == assembly_name && object_is_visible(l_name(p))) {
                render_lumber(p, object_is_highlighted(l_name(p)));
            }
        }
    }
}

module render_component_assembly(assembly_name, enabled) {
    if (enabled) {
        for (c = components) {
            if (c_assembly(c) == assembly_name && object_is_visible(c_name(c))) {
                render_component(c, object_is_highlighted(c_name(c)));
            }
        }
    }
}

module render_conduit_assembly(assembly_name, enabled) {
    if (enabled) {
        for (r = conduits) {
            if (r_assembly(r) == assembly_name && object_is_visible(r_name(r))) {
                render_conduit(r, object_is_highlighted(r_name(r)));
            }
        }
    }
}

module render_cable_assembly(assembly_name, enabled) {
    if (enabled) {
        for (c = cables) {
            if (
                cable_assembly(c) == assembly_name
                    && object_is_visible(cable_name(c))
            ) {
                render_cable(c, object_is_highlighted(cable_name(c)));
            }
        }
    }
}

module render_tambour_assembly(assembly_name, enabled, is_open) {
    if (enabled) {
        for (t = tambours) {
            if (t_assembly(t) == assembly_name && object_is_visible(t_name(t))) {
                render_tambour(t, is_open, object_is_highlighted(t_name(t)));
            }
        }
    }
}

// OpenSCAD cannot dynamically resolve a boolean variable by string,
// so Python emits explicit toggle routing here.
{% for assembly in assemblies %}
if ({{ assembly.toggle }}) {
    render_assembly("{{ assembly.name }}", {{ assembly.toggle }});
}
{% endfor %}
{% for assembly in component_assemblies %}
if ({{ assembly.toggle }}) {
    render_component_assembly("{{ assembly.name }}", {{ assembly.toggle }});
}
{% endfor %}
{% for assembly in conduit_assemblies %}
if ({{ assembly.toggle }}) {
    render_conduit_assembly("{{ assembly.name }}", {{ assembly.toggle }});
}
{% endfor %}
{% for assembly in cable_assemblies %}
if ({{ assembly.toggle }}) {
    render_cable_assembly("{{ assembly.name }}", {{ assembly.toggle }});
}
{% endfor %}
{% for assembly in tambour_assemblies %}
if ({{ assembly.toggle }}) {
    render_tambour_assembly(
        "{{ assembly.name }}",
        {{ assembly.toggle }},
        tambour_door_open
    );
}
{% endfor %}

if (siding) {
    for (s = siding_parts) {
        if (object_is_visible(s_name(s))) {
            render_siding_part(s, object_is_highlighted(s_name(s)));
        }
    }
}

if (ground) {
    for (g = grounds) {
        render_ground(g);
    }
}

if ($preview && xygrid_zloc >= 0 && len(xygrid_bounds) == 4) {
    render_xygrid(xygrid_bounds, xygrid_zloc);
}
